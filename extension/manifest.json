{
  "manifest_version": 3,
  "name": "YouTube Quality",
  "description": "Keep YouTube at the highest playable resolution up to 1440p. Prefer enhanced bitrate when available.",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["quality.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
